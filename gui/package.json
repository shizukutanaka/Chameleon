{
  "name": "chameleon-audio-gui",
  "version": "1.0.0",
  "description": "Experimental desktop GUI for Chameleon (work in progress; not yet wired to the CLI — see gui/README.md)",
  "main": "electron/main.js",
  "homepage": "./",
  "private": true,
  "author": "Chameleon contributors",
  "license": "MIT",
  "scripts": {
    "dev": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron": "electron .",
    "electron-dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron-pack": "npm run build && electron-builder",
    "dist": "npm run build && electron-builder --publish=never"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.0",
    "react-scripts": "5.0.1",
    "@emotion/react": "^11.10.5",
    "@emotion/styled": "^11.10.5",
    "@mui/material": "^5.11.0",
    "@mui/icons-material": "^5.11.0",
    "@mui/x-data-grid": "^5.17.0",
    "recharts": "^2.5.0",
    "axios": "^1.3.0",
    "socket.io-client": "^4.6.0",
    "file-saver": "^2.0.5",
    "react-dropzone": "^14.2.0",
    "react-audio-player": "^0.17.0",
    "wavesurfer.js": "^6.6.0",
    "web-vitals": "^3.1.0"
  },
  "devDependencies": {
    "electron": "^22.0.0",
    "electron-builder": "^23.6.0",
    "concurrently": "^7.6.0",
    "wait-on": "^7.0.1",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/file-saver": "^2.0.5",
    "typescript": "^4.9.4"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "appId": "gov.chameleon.audio",
    "productName": "Chameleon Audio Processor",
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "electron/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "AudioVideo"
    }
  }
}