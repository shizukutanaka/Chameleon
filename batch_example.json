{
  "description": "Batch processing configuration template",
  "jobs": [
    {
      "input": "input1.wav",
      "output": "output1.wav",
      "operation": "normalize",
      "params": {
        "target_level": 0.8
      }
    },
    {
      "input": "input2.wav",
      "output": "output2.wav",
      "operation": "enhance",
      "params": {
        "denoise_level": 0.1,
        "highpass_freq": 100.0,
        "lowpass_freq": 7000.0
      }
    }
  ]
}